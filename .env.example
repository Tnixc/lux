# Auth mode: github or none
LUX_AUTH_MODE=github

GITHUB_CLIENT_ID=something
GITHUB_CLIENT_SECRET=something

# Comma-separated GitHub usernames allowed to sign in (without @)
LUX_GITHUB_ALLOWED_USERS=your-github-username

# Root directory shown in the directory picker. Supports ~ (example: ~/code)
LUX_HOME_DIR=~

# Default agent CLI command used when creating sessions (for example: codex, opencode, amp)
LUX_DEFAULT_AGENT_CLI=amp